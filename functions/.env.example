# Copy to `.env` for local emulator / `firebase emulators:exec`.
# In production, set `RESEND_API_KEY` (and optionally `RESEND_FROM_EMAIL`) in
# Firebase Console → Functions → your function → Environment variables, or
# use `firebase functions:secrets:set RESEND_API_KEY`.

RESEND_API_KEY=
RESEND_FROM_EMAIL=
