rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /notifications/{notifId} {
        // Recipient can read/update/delete their own inbox.
        allow read, update, delete: if request.auth != null
          && request.auth.uid == uid;
        // Anyone authenticated may create a notification for another user
        // only as the sender (owners confirming payments, members uploading proof, etc.).
        allow create: if request.auth != null
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.read == false;
      }
    }

    match /subscriptions/{subId} {
      // Do not use isOwner() here — get() on this same doc causes circular evaluation.
      allow read: if request.auth != null && (
        resource.data.ownerId == request.auth.uid
        || exists(/databases/$(database)/documents/subscriptions/$(subId)/members/$(request.auth.uid))
      );
      allow create: if request.auth != null;
      allow update, delete: if isOwner(subId);

      match /members/{memberUid} {
        // Owner or any member of this subscription can read the roster.
        // resource.data.uid == auth.uid still covers collectionGroup("members").
        allow read: if request.auth != null && (
          resource.data.uid == request.auth.uid
          || isOwner(subId)
          || isMember(subId)
        );
        allow write: if isOwner(subId);
      }

      match /cycles/{cycleId} {
        allow read: if isOwner(subId) || isMember(subId);
        allow write: if isOwner(subId);

        match /payments/{paymentUid} {
          allow read: if isOwner(subId) || isMember(subId);
          // Member uploads proof on their own payment; owner confirms / rejects.
          allow update: if request.auth != null && (
            (request.auth.uid == paymentUid && isMember(subId))
            || isOwner(subId)
          );
          allow create, delete: if isOwner(subId);
        }
      }
    }

    // Explicit collection-group path (same field constraint as the client query).
    match /{path=**}/members/{memberUid} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    function isOwner(subId) {
      return request.auth != null
        && get(/databases/$(database)/documents/subscriptions/$(subId)).data.ownerId == request.auth.uid;
    }

    function isMember(subId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/subscriptions/$(subId)/members/$(request.auth.uid));
    }
  }
}
